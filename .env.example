# ShopGuard Crypto Trading - Environment Variables
# Copy this file to .env and fill in your credentials

# =============================================================================
# HYPERLIQUID (Primary Crypto DEX - Perpetual Futures)
# Get started at: https://app.hyperliquid.xyz/
# Docs: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api
# =============================================================================
HYPERLIQUID_PRIVATE_KEY=your_private_key_here_0x...
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here_0x...
HYPERLIQUID_TESTNET=true  # Use testnet (true) or mainnet (false) ⚠️
HYPERLIQUID_VAULT_ADDRESS=  # Optional: vault trading address

# =============================================================================
# BACKUP EXCHANGES (Optional)
# =============================================================================
# BINANCE_API_KEY=your_binance_api_key_here
# BINANCE_SECRET_KEY=your_binance_secret_key_here

# =============================================================================
# TRADING SETTINGS
# =============================================================================
TRADING_MODE=paper
DEFAULT_BROKER=hyperliquid
INITIAL_CAPITAL=10000  # USDC for crypto trading

# =============================================================================
# API SERVER SETTINGS
# =============================================================================
ENVIRONMENT=production  # development, staging, or production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080  # Comma-separated list
# In development, wildcard "*" is automatically added
