# AI Trading System - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# ALPACA (US Stocks & Crypto)
# Get keys at: https://app.alpaca.markets/
# =============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# =============================================================================
# BINANCE (Crypto)
# Get keys at: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/
# =============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# =============================================================================
# INTERACTIVE BROKERS (Future support)
# =============================================================================
# IB_ACCOUNT=your_ib_account
# IB_HOST=127.0.0.1
# IB_PORT=7497

# =============================================================================
# TRADING SETTINGS
# =============================================================================
TRADING_MODE=paper
DEFAULT_BROKER=paper
INITIAL_CAPITAL=100000
